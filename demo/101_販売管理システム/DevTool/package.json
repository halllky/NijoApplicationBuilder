{
  "name": "devtool-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n DEVTOOL-CLIENT,DEVTOOL-SERVER -c green,blue \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --open --host",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "tsc": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "build": "npm run tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.62",
    "@heroicons/react": "^2.2.0",
    "@hono/node-server": "^2.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "ai": "^7.0.59",
    "envfile": "^7.1.0",
    "execa": "^10.0.1",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "tree-kill": "^1.2.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@github/keytar": "^7.10.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.5"
  }
}
