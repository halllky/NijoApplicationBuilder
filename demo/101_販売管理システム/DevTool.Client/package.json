{
  "name": "devtool-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n DEVTOOL-CLIENT,DEVTOOL-SERVER -c green,blue \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --open",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "tsc": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "build": "npm run tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.37",
    "@ai-sdk/react": "^4.0.62",
    "@hono/node-server": "^2.1.0",
    "ai": "^7.0.59",
    "envfile": "^7.1.0",
    "execa": "^10.0.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.0",
    "tree-kill": "^1.2.2",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@github/keytar": "^7.10.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12"
  }
}
