{
  "browser": "http://localhost:5173",
  "startOnNijoServe": false,
  "concurrently": [
    {
      "name": "vite",
      "process": {
        "cwd": "client",
        "filename": "npm",
        "args": "run dev"
      },
      "log": {
        "stdout": "WebApi/run_npm.log",
        "stderr": "WebApi/run_npm.error.log",
        "appendStdout": false,
        "appendStderr": true
      },
      "restartOnGenerateCode": false
    },
    {
      "name": "dotnet",
      "process": {
        "cwd": "WebApi",
        "filename": "dotnet",
        "args": "run --launch-profile http"
      },
      "log": {
        "stdout": "WebApi/run_dotnet.log",
        "stderr": "WebApi/run_dotnet.error.log",
        "appendStdout": false,
        "appendStderr": true
      },
      "restartOnGenerateCode": true
    }
  ]
}
